From 24963c438c18ffac98e334e8e92d21cc56dc9220 Mon Sep 17 00:00:00 2001
From: Local <local@example.invalid>
Date: Tue, 17 Nov 2026 17:27:24 +0900
Subject: [PATCH 2/2] remoteproc: support scoped TI Vision Apps DMA-BUF address
 query

---
 drivers/remoteproc/Kconfig           |   7 ++
 drivers/remoteproc/remoteproc_cdev.c | 125 +++++++++++++++++++++++++++
 include/uapi/linux/remoteproc_cdev.h |   8 ++
 3 files changed, 140 insertions(+)

diff --git a/drivers/remoteproc/Kconfig b/drivers/remoteproc/Kconfig
index 48a0d3a..c82a86d 100644
--- a/drivers/remoteproc/Kconfig
+++ b/drivers/remoteproc/Kconfig
@@ -23,6 +23,13 @@ config REMOTEPROC_CDEV
 
 	  It's safe to say N if you don't want to use this interface.
 
+config REMOTEPROC_TI_VISION_DMA_BUF
+	bool "TI Vision Apps DMA-BUF address query"
+	depends on REMOTEPROC_CDEV && DMABUF_HEAPS_CARVEOUT
+	help
+	  Support the TI Vision Apps address query ABI for privileged clients
+	  using the Vision Apps reserved-memory DMA heap.
+
 config IMX_REMOTEPROC
 	tristate "i.MX remoteproc support"
 	depends on ARCH_MXC
diff --git a/drivers/remoteproc/remoteproc_cdev.c b/drivers/remoteproc/remoteproc_cdev.c
index 687f205..50cff7c 100644
--- a/drivers/remoteproc/remoteproc_cdev.c
+++ b/drivers/remoteproc/remoteproc_cdev.c
@@ -5,7 +5,10 @@
  * Copyright (c) 2020, The Linux Foundation. All rights reserved.
  */
 
+#include <linux/capability.h>
 #include <linux/cdev.h>
+#include <linux/dma-buf.h>
+#include <linux/slab.h>
 #include <linux/compat.h>
 #include <linux/fs.h>
 #include <linux/module.h>
@@ -18,6 +21,118 @@
 #define NUM_RPROC_DEVICES	64
 static dev_t rproc_major;
 
+#ifdef CONFIG_REMOTEPROC_TI_VISION_DMA_BUF
+struct rproc_cdev_mapping {
+	struct list_head node;
+	struct dma_buf *buf;
+	struct dma_buf_attachment *attachment;
+	struct sg_table *table;
+};
+
+struct rproc_cdev_client {
+	struct mutex lock;
+	struct list_head mappings;
+};
+
+static int rproc_cdev_open(struct inode *inode, struct file *file)
+{
+	struct rproc_cdev_client *client;
+
+	client = kzalloc(sizeof(*client), GFP_KERNEL);
+	if (!client)
+		return -ENOMEM;
+
+	mutex_init(&client->lock);
+	INIT_LIST_HEAD(&client->mappings);
+	file->private_data = client;
+	return 0;
+}
+
+static long rproc_cdev_attach_buf(struct file *file, struct rproc *rproc,
+				  void __user *arg)
+{
+	struct rproc_cdev_client *client = file->private_data;
+	struct rproc_dma_buf_attach_data data;
+	struct rproc_cdev_mapping *mapping;
+	struct scatterlist *sg;
+	int ret;
+
+	if (!capable(CAP_SYS_RAWIO))
+		return -EPERM;
+	if (copy_from_user(&data, arg, sizeof(data)))
+		return -EFAULT;
+
+	mapping = kzalloc(sizeof(*mapping), GFP_KERNEL);
+	if (!mapping)
+		return -ENOMEM;
+
+	mapping->buf = dma_buf_get(data.fd);
+	if (IS_ERR(mapping->buf)) {
+		ret = PTR_ERR(mapping->buf);
+		goto free_mapping;
+	}
+	if (strcmp(mapping->buf->exp_name, "carveout_vision_apps_shared-memories")) {
+		ret = -EINVAL;
+		goto put_buf;
+	}
+	mapping->attachment = dma_buf_attach(mapping->buf, &rproc->dev);
+	if (IS_ERR(mapping->attachment)) {
+		ret = PTR_ERR(mapping->attachment);
+		goto put_buf;
+	}
+	mapping->table = dma_buf_map_attachment(mapping->attachment, DMA_BIDIRECTIONAL);
+	if (IS_ERR(mapping->table)) {
+		ret = PTR_ERR(mapping->table);
+		goto detach_buf;
+	}
+	sg = mapping->table->sgl;
+	/* Vision Apps uses the returned address as a physical address. */
+	if (mapping->table->orig_nents != 1 || mapping->table->nents != 1 ||
+	    sg_dma_len(sg) < mapping->buf->size || sg_dma_address(sg) != sg_phys(sg)) {
+		ret = -ERANGE;
+		goto unmap_buf;
+	}
+	data.da = sg_dma_address(sg);
+	if (copy_to_user(arg, &data, sizeof(data))) {
+		ret = -EFAULT;
+		goto unmap_buf;
+	}
+	mutex_lock(&client->lock);
+	list_add_tail(&mapping->node, &client->mappings);
+	mutex_unlock(&client->lock);
+	return 0;
+
+unmap_buf:
+	dma_buf_unmap_attachment(mapping->attachment, mapping->table, DMA_BIDIRECTIONAL);
+detach_buf:
+	dma_buf_detach(mapping->buf, mapping->attachment);
+put_buf:
+	dma_buf_put(mapping->buf);
+free_mapping:
+	kfree(mapping);
+	return ret;
+}
+
+static void rproc_cdev_release_bufs(struct file *file)
+{
+	struct rproc_cdev_client *client = file->private_data;
+	struct rproc_cdev_mapping *mapping, *next;
+
+	list_for_each_entry_safe(mapping, next, &client->mappings, node) {
+		list_del(&mapping->node);
+		dma_buf_unmap_attachment(mapping->attachment, mapping->table,
+					 DMA_BIDIRECTIONAL);
+		dma_buf_detach(mapping->buf, mapping->attachment);
+		dma_buf_put(mapping->buf);
+		kfree(mapping);
+	}
+	mutex_destroy(&client->lock);
+	kfree(client);
+}
+
+MODULE_IMPORT_NS("DMA_BUF");
+#endif
+
 static ssize_t rproc_cdev_write(struct file *filp, const char __user *buf, size_t len, loff_t *pos)
 {
 	struct rproc *rproc = container_of(filp->f_inode->i_cdev, struct rproc, cdev);
@@ -64,6 +179,10 @@ static long rproc_device_ioctl(struct file *filp, unsigned int ioctl, unsigned l
 			return -EFAULT;
 
 		break;
+#ifdef CONFIG_REMOTEPROC_TI_VISION_DMA_BUF
+	case RPROC_IOC_DMA_BUF_ATTACH:
+		return rproc_cdev_attach_buf(filp, rproc, argp);
+#endif
 	default:
 		dev_err(&rproc->dev, "Unsupported ioctl\n");
 		return -EINVAL;
@@ -77,6 +196,9 @@ static int rproc_cdev_release(struct inode *inode, struct file *filp)
 	struct rproc *rproc = container_of(inode->i_cdev, struct rproc, cdev);
 	int ret = 0;
 
+#ifdef CONFIG_REMOTEPROC_TI_VISION_DMA_BUF
+	rproc_cdev_release_bufs(filp);
+#endif
 	if (!rproc->cdev_put_on_release)
 		return 0;
 
@@ -89,6 +211,9 @@ static int rproc_cdev_release(struct inode *inode, struct file *filp)
 }
 
 static const struct file_operations rproc_fops = {
+#ifdef CONFIG_REMOTEPROC_TI_VISION_DMA_BUF
+	.open = rproc_cdev_open,
+#endif
 	.write = rproc_cdev_write,
 	.unlocked_ioctl = rproc_device_ioctl,
 	.compat_ioctl = compat_ptr_ioctl,
diff --git a/include/uapi/linux/remoteproc_cdev.h b/include/uapi/linux/remoteproc_cdev.h
index c43768e..569cf1c 100644
--- a/include/uapi/linux/remoteproc_cdev.h
+++ b/include/uapi/linux/remoteproc_cdev.h
@@ -34,4 +34,12 @@
  */
 #define RPROC_GET_SHUTDOWN_ON_RELEASE _IOR(RPROC_MAGIC, 2, __s32)
 
+/* TI SDK ABI. The device address occupies the 64-bit field at offset 8. */
+struct rproc_dma_buf_attach_data {
+	__u32 fd;
+	__aligned_u64 da;
+};
+
+#define RPROC_IOC_DMA_BUF_ATTACH _IOWR(RPROC_MAGIC, 0, struct rproc_dma_buf_attach_data)
+
 #endif
-- 
2.53.0

